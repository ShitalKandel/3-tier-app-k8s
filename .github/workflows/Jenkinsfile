pipeline {
    agent any

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-creds')
        DOCKERHUB_USERNAME    = credentials('dockerhub-username')
        DISCORD_WEBHOOK       = credentials('discord-webhook')
        IMAGE_TAG             = "${BUILD_NUMBER}"
    }

    stages {

   
        // 1. CHECKOUT
    
        stage('Checkout') {
            steps {
                echo "📥 Checking out source code..."
                git branch: 'main',
                    url: 'https://github.com/mister-aayush/deploy-3tier.git'
            }
        }

        // 2. BUILD DOCKER IMAGES

        stage('Build Docker Images') {
            parallel {
                stage('Build Backend') {
                    steps {
                        echo " Building backend image..."
                        sh """
                            docker build -t ${DOCKERHUB_USERNAME}/backend:${IMAGE_TAG} \
                                         -t ${DOCKERHUB_USERNAME}/backend:latest \
                                         ./backend
                        """
                    }
                }
                stage('Build Frontend') {
                    steps {
                        echo " Building frontend image..."
                        sh """
                            docker build -t ${DOCKERHUB_USERNAME}/frontend:${IMAGE_TAG} \
                                         -t ${DOCKERHUB_USERNAME}/frontend:latest \
                                         ./frontend
                        """
                    }
                }
            }
        }


        // 3. PUSH TO DOCKER HUB

        stage('Push to Docker Hub') {
            steps {
                echo " Pushing images to Docker Hub..."
                sh """
                    echo ${DOCKERHUB_CREDENTIALS_PSW} | \
                        docker login -u ${DOCKERHUB_CREDENTIALS_USR} --password-stdin

                    docker push ${DOCKERHUB_USERNAME}/backend:${IMAGE_TAG}
                    docker push ${DOCKERHUB_USERNAME}/backend:latest
                    docker push ${DOCKERHUB_USERNAME}/frontend:${IMAGE_TAG}
                    docker push ${DOCKERHUB_USERNAME}/frontend:latest
                """
            }
        }


        // 4. DEPLOY TO KUBERNETES
       
        stage('Deploy to Kubernetes') {
            steps {
                echo " Deploying to Kubernetes..."
                sh """
                    kubectl apply -f k8s/database-statefulset.yml
                    kubectl apply -f k8s/backend-deployment.yml
                    kubectl apply -f k8s/frontend-deployment.yml
                    kubectl apply -f k8s/hpa.yml

                    kubectl rollout restart deployment/backend-deploy
                    kubectl rollout restart deployment/frontend-deploy
                """
            }
        }


        // 5. VERIFY ROLLOUT

        stage('Verify Rollout') {
            steps {
                echo " Verifying rollout..."
                sh """
                    kubectl rollout status deployment/backend-deploy  --timeout=120s
                    kubectl rollout status deployment/frontend-deploy --timeout=120s
                    kubectl get pods -n three-tier
                """
            }
        }
    }

    
    // POST — DISCORD NOTIFICATIONS
    
    post {

        success {
            echo "✅ Pipeline succeeded!"
            sh """
                curl -s -H "Content-Type: application/json" \
                -X POST \
                -d '{
                    "embeds": [{
                        "title": "✅ Deployment Successful",
                        "color": 3066993,
                        "fields": [
                            { "name": "Project",   "value": "3-Tier App",          "inline": true },
                            { "name": "Branch",    "value": "main",                "inline": true },
                            { "name": "Build",     "value": "#${BUILD_NUMBER}",    "inline": true },
                            { "name": "Images",    "value": "backend:${IMAGE_TAG} & frontend:${IMAGE_TAG}", "inline": false },
                            { "name": "Status",    "value": "Deployed to K8s successfully 🚀", "inline": false }
                        ],
                        "footer": { "text": "Jenkins CI/CD" }
                    }]
                }' \
                ${DISCORD_WEBHOOK}
            """
        }

        failure {
            echo "❌ Pipeline failed!"
            sh """
                curl -s -H "Content-Type: application/json" \
                -X POST \
                -d '{
                    "embeds": [{
                        "title": "❌ Deployment Failed",
                        "color": 15158332,
                        "fields": [
                            { "name": "Project",  "value": "3-Tier App",       "inline": true },
                            { "name": "Branch",   "value": "main",             "inline": true },
                            { "name": "Build",    "value": "#${BUILD_NUMBER}", "inline": true },
                            { "name": "Stage",    "value": "Check Jenkins logs for details ⚠️", "inline": false }
                        ],
                        "footer": { "text": "Jenkins CI/CD" }
                    }]
                }' \
                ${DISCORD_WEBHOOK}
            """
        }

        aborted {
            sh """
                curl -s -H "Content-Type: application/json" \
                -X POST \
                -d '{
                    "embeds": [{
                        "title": "⚠️ Deployment Aborted",
                        "color": 15105570,
                        "fields": [
                            { "name": "Project", "value": "3-Tier App",       "inline": true },
                            { "name": "Build",   "value": "#${BUILD_NUMBER}", "inline": true },
                            { "name": "Info",    "value": "Pipeline was manually aborted.", "inline": false }
                        ],
                        "footer": { "text": "Jenkins CI/CD" }
                    }]
                }' \
                ${DISCORD_WEBHOOK}
            """
        }

        always {
            echo "🧹 Cleaning up local Docker images..."
            sh """
                docker rmi ${DOCKERHUB_USERNAME}/backend:${IMAGE_TAG}  || true
                docker rmi ${DOCKERHUB_USERNAME}/frontend:${IMAGE_TAG} || true
            """
        }
    }
}